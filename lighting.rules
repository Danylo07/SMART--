var Timer lightTimer = null
rule "Автосвітло за рухом"
when Item MotionDetector changed to ON
then
 LivingRoomLight.sendCommand(ON)
 if (now.getHour() >= 6 && now.getHour() < 22) LivingRoomBrightness.sendCommand(80)
 else LivingRoomBrightness.sendCommand(30)
 if (lightTimer !== null) lightTimer.cancel()
 lightTimer = createTimer(now.plusMinutes(5), [ |
  if (MotionDetector.state != ON) LivingRoomLight.sendCommand(OFF)
  lightTimer = null
 ])
 logInfo("Lighting", "Рух виявлено; освітлення активовано")
end
rule "Керування всім освітленням"
when Item AllLights received command
then
 LivingRoomLight.sendCommand(receivedCommand)
 BedroomLight.sendCommand(receivedCommand)
 KitchenLight.sendCommand(receivedCommand)
 if (receivedCommand == ON) { LivingRoomBrightness.sendCommand(70); BedroomBrightness.sendCommand(70); KitchenBrightness.sendCommand(70) }
end
rule "Вечірній режим"
when Time cron "0 0 19 * * ?"
then LivingRoomLight.sendCommand(ON); LivingRoomBrightness.sendCommand(60); BedroomLight.sendCommand(ON); BedroomBrightness.sendCommand(40); HomeMode.postUpdate("EVENING")
end
rule "Нічний режим"
when Time cron "0 0 23 * * ?"
then AllLights.sendCommand(OFF); HomeMode.postUpdate("NIGHT")
end