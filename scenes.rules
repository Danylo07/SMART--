rule "Сценарні режими"
when Item SceneMode received command
then
 val s = receivedCommand.toString
 logInfo("Scenes", "Сценарій: " + s)
 if (s == "MORNING") { AllLights.sendCommand(ON); LivingRoomBrightness.sendCommand(80); KitchenDimmer.sendCommand(65); TargetTemperature.sendCommand(22); HomeMode.postUpdate("HOME") }
 else if (s == "DAY") { AllLights.sendCommand(OFF); KitchenDimmer.sendCommand(0); TargetTemperature.sendCommand(20); HomeMode.postUpdate("HOME") }
 else if (s == "EVENING") { LivingRoomLight.sendCommand(ON); LivingRoomBrightness.sendCommand(60); KitchenDimmer.sendCommand(45); TargetTemperature.sendCommand(22.5); HomeMode.postUpdate("EVENING") }
 else if (s == "NIGHT") { AllLights.sendCommand(OFF); KitchenDimmer.sendCommand(0); TargetTemperature.sendCommand(19); HomeMode.postUpdate("NIGHT") }
end